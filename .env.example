# La demo local no requiere credenciales. Este archivo es una plantilla: copialo a .env (fuera de Git).

# Apify: una o varias cuentas, cada una con su línea (APIFY_TOKEN, APIFY_TOKEN_2, ...).
APIFY_TOKEN=

# Make: URL del webhook personalizado del escenario que envía las alertas (https://hook.<región>.make.com/...).
MAKE_WEBHOOK_URL=

# Make: URL del webhook del escenario que recibe las altas de búsquedas con aviso por correo.
# La escribe `python -m precio_entorno.make_escenarios crear`.
MAKE_BUSQUEDAS_WEBHOOK_URL=

# Make: token de la API (scenarios:read/write/run, hooks:read/write, connections:read) y mail del equipo
# que recibe los avisos de corridas fallidas.
MAKE_API_TOKEN=
MAKE_EQUIPO_EMAIL=
